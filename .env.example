# Required in production: long random string used to sign session cookies
SESSION_SECRET=
# Supabase project (schema grader_ai). The service role key is server only: never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in email links
APP_URL=http://localhost:3000
# Optional SMTP. When set, email verification is required and reset links are emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Grader AI <no-reply@example.com>"
# Optional: enables model based grading suggestions (otherwise a rule based draft engine is used)
ANTHROPIC_API_KEY=
# Optional: URL of an isolated code execution service for the programming autograder
SANDBOX_URL=
SANDBOX_TOKEN=
EXPOSE_RESET_LINKS=false
